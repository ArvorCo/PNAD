      ],
      "css": "@media (min-width:980px){body:not(.modo-lista) .app{height:100vh!important}}",
      "nota": "Busca pelo CEP 21810-000 (Bangu, Rio de Janeiro; três locais de votação com o CEP exato no índice do app), raio 2 km, e a ficha do prédio mais perto do centro da busca.",
      "passos": [
        {
          "acao": "esperar_js",
          "js": "() => { const S = window.fiscaisMapa && window.fiscaisMapa.estado; return Boolean(S && S.recorte && S.cluster && S.cluster.getLayers().length > 0 && !S.loteMapa); }",
          "tempo": 60
        },
        {
          "acao": "tiles"
        },
        {
          "acao": "pausa",
          "s": 1.2
        },
        {
          "acao": "still",
          "nome": "inicio"
        },
        {
          "acao": "clicar",
          "sel": "#filtros-toggle",
          "formatos": [
            "9x16"
          ]
        },
        {
          "acao": "pausa",
          "s": 0.8,
          "formatos": [
            "9x16"
          ]
        },
        {
          "acao": "digitar",
          "sel": "#q-cep",
          "texto": "21810000"
        },
        {
          "acao": "pausa",
          "s": 0.5
        },
        {
          "acao": "clicar",
          "sel": "#raios button[data-r='2']"
        },
        {
          "acao": "pausa",
          "s": 0.5
        },
        {
          "acao": "clicar",
          "sel": "#f-busca button[type=submit]"
        },
        {
          "acao": "esperar_js",
          "js": "() => { const S = window.fiscaisMapa.estado; return Boolean(S.centro) && S.raio === 2 && !S.loteMapa; }",
          "tempo": 30
        },
        {
          "acao": "rolar",
          "ate": "main.app",
          "duracao": 1.0,
          "margem": 0,
          "formatos": [
            "16x9"
          ]
        },
        {
          "acao": "rolar",
          "ate": "#palco",
          "duracao": 1.0,
          "margem": 0,
          "formatos": [
            "9x16"
          ]
        },
        {
          "acao": "pausa",
          "s": 1.0
        },
        {
          "acao": "tiles"
        },
        {
          "acao": "pausa",
          "s": 1.0
        },
        {
          "acao": "still",
          "nome": "resultado"
        },
        {
          "acao": "js",
          "js": "() => { const S = window.fiscaisMapa.estado; S.mapa.setView([S.centro.lat, S.centro.lon], 16, { animate: true }); }"
        },
        {
          "acao": "pausa",
          "s": 1.2
        },
        {
          "acao": "tiles"
        },
        {
          "acao": "esperar_js",
          "js": "() => { const S = window.fiscaisMapa.estado; const c = S.centro; let melhor = null; let d = Infinity; S.marcadores.forEach((m) => { if (!m._icon || S.cluster.getVisibleParent(m) !== m) return; const p = m.getLatLng(); const r = m._icon.getBoundingClientRect(); if (r.top < 60 || r.bottom > innerHeight - 40) return; const dd = (p.lat - c.lat) ** 2 + (p.lng - c.lon) ** 2; if (dd < d) { d = dd; melhor = m; } }); document.querySelectorAll('#__alvo').forEach((e) => e.removeAttribute('id')); if (melhor) melhor._icon.id = '__alvo'; return Boolean(melhor); }",
          "tempo": 15
        },
        {
          "acao": "clicar",
          "sel": "#__alvo"
        },
        {
          "acao": "esperar_js",
          "js": "() => Boolean(window.fiscaisMapa.estado.aberto)",
          "tempo": 20
        },
        {
          "acao": "pausa",
          "s": 2.0
        },
        {
          "acao": "still",
          "nome": "ficha"
        },
        {
          "acao": "pausa",
          "s": 1.0
        }
      ]
